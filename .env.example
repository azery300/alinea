# Copy to .env and fill in. Never commit .env.

# Postgres (matches compose.yaml)
DATABASE_URL=postgresql://alinea:alinea@localhost:5432/alinea
POSTGRES_PORT=5432

# Langfuse cloud (step 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Mistral API (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIM=1024
